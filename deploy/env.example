# Copiar a /etc/gateway_prepagos/env (dueño gateway, permisos 0600).
# Nunca poner valores reales en este archivo.

GATEWAY_DATABASE_URL=postgresql+psycopg:///gateway_prepagos
# Generar con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATEWAY_MASTER_KEY=
GATEWAY_API_HOST=127.0.0.1
GATEWAY_API_PORT=8000
GATEWAY_LOG_LEVEL=INFO
